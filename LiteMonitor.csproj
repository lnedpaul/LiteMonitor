<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET 9+ 新增 WFO1000（默认 Error）：要求 Control 派生类的公开属性显式声明设计器序列化方式。
         本项目全部窗体/控件为纯代码自绘，不使用 WinForms 设计器，该规则无实际风险；
         按微软官方建议抑制，避免为 14 个属性加无意义特性。二期可评估逐个补 DesignerSerializationVisibility。 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>resources\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	  
    <Version>1.3.7</Version><!-- 程序主版本（UpdateChecker / About用） -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion><!-- 稳定不动 -->
    <FileVersion>1.3.7.0</FileVersion><!-- 文件属性显示 -->
  </PropertyGroup>


	<ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- .NET 10 已内置 System.Text.Json 10.0.x；显式引用 9.0.10 会触发 NU1510 并可能降级程序集 -->
  </ItemGroup>

    <!-- ==================================================================
         资源处理分两种发布形态（由 build-net10.ps1 传入 PublishSingleFile 决定）：

         A) 常规构建 / 多文件发布：资源作为 Content 复制到输出目录（上游原行为）。
         B) 单文件发布：资源改为 EmbeddedResource 打进 exe。
            单文件应用的 AppContext.BaseDirectory 指向 exe 所在目录，
            bundle 的自解压临时目录无法被现有代码直接访问，因此由
            ResourceBootstrapper 在启动最早期把资源释放回 exe 旁的 resources，
            这样 LanguageManager / ThemeManager / PluginManager / UpdateDialog
            现有的 BaseDirectory 读取逻辑完全不用改。

         注意：RuntimeIdentifier / SelfContained 只在 publish 命令行传入，
         不写进 csproj，避免改变默认 build 输出路径（test 项目的 HintPath 依赖它）。
         ================================================================== -->

    <!-- A) 常规形态：复制 -->
    <ItemGroup Condition="'$(PublishSingleFile)' != 'true'">
        <Content Include="resources\themes\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="resources\lang\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="resources\plugins\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <!-- 更新器由 build-net10.ps1 构建期生成，可能尚未存在于干净 clone 中 -->
        <Content Include="resources\LiteMonitor.Updater.exe" Condition="Exists('resources\LiteMonitor.Updater.exe')">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <!-- 上游仓库未提交该文件；加 Exists 条件避免 MSB3030，文件补齐后自动恢复复制 -->
        <Content Include="使用说明(必读).txt" Condition="Exists('使用说明(必读).txt')">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <!-- B) 单文件形态：嵌入 exe，启动期按需释放（已存在的文件不覆盖） -->
    <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
        <EmbeddedResource Include="resources\themes\*.json">
            <LogicalName>LiteMonitor.Embedded.resources/themes/%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <EmbeddedResource Include="resources\lang\*.json">
            <LogicalName>LiteMonitor.Embedded.resources/lang/%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <EmbeddedResource Include="resources\plugins\*.json">
            <LogicalName>LiteMonitor.Embedded.resources/plugins/%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <EmbeddedResource Include="resources\LiteMonitor.Updater.exe" Condition="Exists('resources\LiteMonitor.Updater.exe')">
            <LogicalName>LiteMonitor.Embedded.resources/LiteMonitor.Updater.exe</LogicalName>
        </EmbeddedResource>

        <EmbeddedResource Include="使用说明(必读).txt" Condition="Exists('使用说明(必读).txt')">
            <LogicalName>LiteMonitor.Embedded.使用说明(必读).txt</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
	
	
<ItemGroup>
  <Compile Remove="test\**" />
  <Compile Remove="LiteMonitor.Updater\**" />
  <Compile Remove="LiteMonitor.Wpf\**" />
  <EmbeddedResource Remove="LiteMonitor.Updater\**" />
  <EmbeddedResource Remove="LiteMonitor.Wpf\**" />
  <None Remove="LiteMonitor.Updater\**" />
  <None Remove="LiteMonitor.Wpf\**" />
</ItemGroup>
	
<!-- 引入文件资源管理 -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
<!-- 引入文件资源管理 -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="src\UI\Settings\" />
  </ItemGroup>
</Project>
